# Plantilla de variables de entorno de EduVibe.
# Copia este archivo a .env.production, rellena los valores y arranca con:
#   docker compose --env-file .env.production -f Docker-compose.yml up -d --build
# El archivo con valores reales NUNCA se sube al repositorio (está en .gitignore).

# --- Base de datos -----------------------------------------------------------
BBDD_PORT=5432
BBDD_NAME=eduvibe
DATABASE_USERNAME=eduvibe
# Contraseña fuerte. Ojo: Postgres solo la aplica al crear el volumen por primera
# vez; cambiarla después exige cambiarla también dentro de la base de datos.
DATABASE_PASSWORD=

# --- API ---------------------------------------------------------------------
APP_PORT=9090
# Clave de firma de los JWT. Obligatoria en producción: si falta, el backend
# genera una aleatoria en cada arranque y todas las sesiones se cierran al reiniciar.
# Genera una con:  openssl rand -base64 48
JWT_SECRET=

# --- URLs y CORS -------------------------------------------------------------
# Dominio público del frontend (se usa en los enlaces de los correos).
FRONTEND_URL=https://eduvibe.example.com
# Orígenes que pueden llamar a la API, separados por comas.
CORS_ALLOWED_ORIGINS=https://eduvibe.example.com

# --- Datos de demostración ---------------------------------------------------
# Producción: solo las migraciones, sin cuentas ni contraseñas de demo.
# Desarrollo / demo: classpath:db/migration,classpath:db/demo
FLYWAY_LOCATIONS=classpath:db/migration

# --- Correo (invitaciones y recuperar contraseña) ----------------------------
# Sin esto, esos dos flujos no pueden enviar enlaces.
# Servidor SMTP. Gmail: smtp.gmail.com / 587. Brevo: smtp-relay.brevo.com / 587.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Dirección que aparece como remitente (De:). Con Brevo debe ser un remitente verificado
# en su panel; con Gmail puede dejarse vacía y se usa MAIL_USERNAME.
MAIL_FROM=

# --- Primer administrador ----------------------------------------------------
# Solo se crea si la base de datos no tiene ningún usuario (instalación nueva).
# Contraseña de al menos 12 caracteres. Tras el primer arranque, cámbiala desde
# el perfil y borra ADMIN_PASSWORD de este archivo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
ORGANIZATION_NAME=EduVibe
